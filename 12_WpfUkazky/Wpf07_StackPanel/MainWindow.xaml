<!-- ===== WPF 07 – Rozloženie: StackPanel, Margin, Padding =====
     Pojem: StackPanel (Vertical/Horizontal), Margin, Padding, HorizontalAlignment
     Skús zmeniť:
       1. Zmeň Orientation vrchného StackPanelu na Horizontal.
       2. Zmeň Margin tlačidiel a sleduj medzery.
       3. Zmeň Padding vo farebnom rámčeku.
       4. Zmeň HorizontalAlignment posledného tlačidla na Left, Center, Stretch.
-->
<Window x:Class="Wpf07_StackPanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StackPanel" Height="480" Width="460">
    <StackPanel Margin="20">
        <TextBlock Text="Zvislý StackPanel (predvolený)" FontWeight="Bold" FontSize="16"/>
        <Button Content="Prvé" Margin="0,5,0,0" Height="32"/>
        <Button Content="Druhé" Margin="0,5,0,0" Height="32"/>
        <Button Content="Tretie" Margin="0,5,0,0" Height="32"/>

        <TextBlock Text="Vodorovný StackPanel" FontWeight="Bold" FontSize="16" Margin="0,20,0,5"/>
        <StackPanel Orientation="Horizontal">
            <Button Content="A" Width="60" Height="32" Margin="0,0,10,0"/>
            <Button Content="B" Width="60" Height="32" Margin="0,0,10,0"/>
            <Button Content="C" Width="60" Height="32"/>
        </StackPanel>

        <TextBlock Text="Margin a Padding" FontWeight="Bold" FontSize="16" Margin="0,20,0,5"/>
        <Border Background="LightBlue" Padding="20" Margin="30,0,30,0">
            <TextBlock Text="Padding = vnútorná medzera, Margin = vonkajšia medzera." TextWrapping="Wrap"/>
        </Border>

        <Button Content="Zarovnané doprava" HorizontalAlignment="Right" Padding="12,6" Margin="0,20,0,0"/>
    </StackPanel>
</Window>
