<!-- ===== WPF 12 – Mini aplikácia: kalkulačka =====
     Pojem: TextBox → číslo (double.Parse), operátory, metódy s parametrom
     Skús zmeniť:
       1. Pridaj tlačidlo pre zvyšok po delení (%).
       2. Pridaj tlačidlo, ktoré vypočíta priemer dvoch čísel.
       3. Zadaj do poľa písmená a stlač tlačidlo – čo sa stane? (Pozri chybové hlásenie.)
       4. Skús delenie nulou. Čo vypíše?
-->
<Window x:Class="Wpf12_Calculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kalkulačka" Height="330" Width="420">
    <StackPanel Margin="20">
        <Label Content="Prvé číslo:"/>
        <TextBox x:Name="txtA" FontSize="18" Padding="3"/>
        <Label Content="Druhé číslo:" Margin="0,8,0,0"/>
        <TextBox x:Name="txtB" FontSize="18" Padding="3"/>

        <UniformGrid Columns="4" Margin="0,15,0,0">
            <Button Content="+" FontSize="24" Height="46" Margin="3" Click="BtnAdd_Click"/>
            <Button Content="−" FontSize="24" Height="46" Margin="3" Click="BtnSubtract_Click"/>
            <Button Content="×" FontSize="24" Height="46" Margin="3" Click="BtnMultiply_Click"/>
            <Button Content="÷" FontSize="24" Height="46" Margin="3" Click="BtnDivide_Click"/>
        </UniformGrid>

        <Label x:Name="lblResult" Content="Výsledok:" FontSize="24" FontWeight="Bold" Margin="0,10,0,0"/>
    </StackPanel>
</Window>
