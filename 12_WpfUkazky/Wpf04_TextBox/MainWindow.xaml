<!-- ===== WPF 04 – TextBox – zadávanie textu =====
     Pojem: TextBox (Text), MaxLength, IsReadOnly, viacriadkový TextBox, Focus()
     Skús zmeniť:
       1. Zmeň pozdrav na iný text (napr. "Vitaj, ...").
       2. Zmeň MaxLength v poslednom poli.
       3. Pridaj druhé pole na priezvisko a vypíš meno aj priezvisko.
       4. Pridaj tlačidlo, ktoré prevedie text na VEĽKÉ písmená: txtName.Text.ToUpper().
-->
<Window x:Class="Wpf04_TextBox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TextBox" Height="520" Width="460">
    <StackPanel Margin="20">
        <Label Content="Ako sa voláš?" FontSize="18"/>
        <TextBox x:Name="txtName" FontSize="18" Padding="4"/>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="btnGreet" Content="Pozdraviť" FontSize="16" Width="120" Height="36" Click="BtnGreet_Click"/>
            <Button x:Name="btnClear" Content="Vymazať" FontSize="16" Width="120" Height="36" Margin="10,0,0,0" Click="BtnClear_Click"/>
        </StackPanel>
        <Label x:Name="lblGreeting" Content="" FontSize="22" Margin="0,10,0,10"/>

        <Label Content="Viacriadkové pole (AcceptsReturn):"/>
        <TextBox x:Name="txtNote" Height="80" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

        <Label Content="Pole len na čítanie (IsReadOnly):" Margin="0,10,0,0"/>
        <TextBox x:Name="txtReadOnly" Text="Toto nejde prepísať" IsReadOnly="True" Background="WhiteSmoke"/>

        <Label Content="Najviac 5 znakov (MaxLength):" Margin="0,10,0,0"/>
        <TextBox x:Name="txtLimited" MaxLength="5"/>
    </StackPanel>
</Window>
