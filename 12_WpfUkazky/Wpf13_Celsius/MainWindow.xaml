<!-- ===== WPF 13 – Mini aplikácia: prevodník teploty =====
     Pojem: vzorce, dva smery prevodu, Grid
     Skús zmeniť:
       1. Pridaj prevod na Kelviny (K = C + 273.15).
       2. Zmeň vzorec tak, aby bol zlý (napr. bez zátvoriek) a over hodnotu 100 °C. Čo vyjde?
       3. Pridaj obrázok slnka a mesiaca (Image) k jednotlivým riadkom.
       4. Pridaj tlačidlo Vymazať, ktoré vyčistí polia.
-->
<Window x:Class="Wpf13_Celsius.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prevodník teploty" Height="260" Width="460">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="°C" FontSize="18" HorizontalAlignment="Center"/>
        <Label Grid.Row="0" Grid.Column="2" Content="°F" FontSize="18" HorizontalAlignment="Center"/>

        <TextBox x:Name="txtCelsius" Grid.Row="1" Grid.Column="0" FontSize="22" Padding="4" HorizontalContentAlignment="Center"/>
        <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0">
            <Button Content="→" FontSize="18" Width="50" Margin="0,0,0,4" Click="BtnToFahrenheit_Click"/>
            <Button Content="←" FontSize="18" Width="50" Click="BtnToCelsius_Click"/>
        </StackPanel>
        <TextBox x:Name="txtFahrenheit" Grid.Row="1" Grid.Column="2" FontSize="22" Padding="4" HorizontalContentAlignment="Center"/>

        <Label x:Name="lblInfo" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Content="Zadaj teplotu a stlač šípku." Margin="0,15,0,0"/>
    </Grid>
</Window>
