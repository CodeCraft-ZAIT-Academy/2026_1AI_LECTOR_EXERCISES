<!-- ===== WPF 01 – Prvé okno =====
     Pojem: Window, XAML vs. C# code-behind
     Skús zmeniť:
       1. Zmeň Title, Width a Height okna.
       2. Zmeň Background na LightBlue, #FFE0B2 alebo inú farbu.
       3. Pridaj ResizeMode="NoResize" – čo sa zmení?
       4. Zmeň text a veľkosť písma v Label.
-->
<Window x:Class="Wpf01_FirstWindow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Moje prvé okno" Height="300" Width="500" Background="LightYellow" WindowStartupLocation="CenterScreen">
    <Grid>
        <Label Content="Hello WPF!" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
</Window>
