<!-- ===== WPF 06 – Obrázok ako tlačidlo =====
     Pojem: Button s obsahom (Image + TextBlock), klikateľný Image (MouseLeftButtonUp)
     Skús zmeniť:
       1. Zmeň ikonu na iný obrázok (roll.png, cola.png, ...).
       2. Pridaj ďalšie tlačidlo s iným obrázkom, ktoré tiež pridáva do košíka.
       3. Zmeň smajlíka tak, aby sa po kliknutí zmenil na slnko.
       4. Pridaj Image, ktorý po kliknutí vráti smajlíka späť.
-->
<Window x:Class="Wpf06_ImageButton.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Obrázok ako tlačidlo" Height="470" Width="440">
    <StackPanel Margin="15">
        <Label x:Name="lblApples" Content="Jabĺk v košíku: 0" FontSize="22"/>

        <Button x:Name="btnAddApple" Height="80" Margin="0,0,0,15" Click="BtnAddApple_Click">
            <StackPanel Orientation="Horizontal">
                <Image Source="Images/apple.png" Width="56" Height="56" Margin="0,0,12,0"/>
                <TextBlock Text="Pridať jablko" FontSize="22" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>

        <TextBlock Text="Tlačidlo, ktoré je len obrázok:" Margin="0,0,0,5"/>
        <Button x:Name="btnImageOnly" Width="90" Height="90" HorizontalAlignment="Left" Click="BtnAddApple_Click">
            <Image Source="Images/apple.png"/>
        </Button>

        <TextBlock Text="Samotný Image reaguje na klik myšou:" Margin="0,20,0,5"/>
        <Image x:Name="imgSmiley" Source="Images/smiley.png" Width="80" Height="80"
               HorizontalAlignment="Left" Cursor="Hand" MouseLeftButtonUp="ImgSmiley_Click"/>
        <Label x:Name="lblSmiley" Content="Klikni na smajlíka."/>
    </StackPanel>
</Window>
