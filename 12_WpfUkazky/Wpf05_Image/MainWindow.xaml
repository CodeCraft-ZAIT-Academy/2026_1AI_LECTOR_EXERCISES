<!-- ===== WPF 05 – Image – obrázky =====
     Pojem: Image (Source, Stretch), zmena obrázka v kóde
     Skús zmeniť:
       1. Zmeň Stretch pri prvom obrázku a sleduj rozdiel.
       2. Zmeň Width a Height obrázka dole.
       3. Pridaj piate tlačidlo, ktoré zobrazí jablko (apple.png).
       4. Pridaj do priečinka Images vlastný PNG a zobraz ho.
-->
<Window x:Class="Wpf05_Image.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Image" Height="540" Width="640">
    <StackPanel Margin="15">
        <TextBlock Text="Vlastnosť Stretch určuje, ako sa obrázok prispôsobí rámčeku:" FontSize="16" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <StackPanel Margin="0,0,15,0">
                <Border BorderBrush="Gray" BorderThickness="1" Width="120" Height="80" ClipToBounds="True">
                    <Image Source="Images/smiley.png" Stretch="Uniform"/>
                </Border>
                <TextBlock Text="Uniform" HorizontalAlignment="Center"/>
            </StackPanel>
            <StackPanel Margin="0,0,15,0">
                <Border BorderBrush="Gray" BorderThickness="1" Width="120" Height="80" ClipToBounds="True">
                    <Image Source="Images/smiley.png" Stretch="Fill"/>
                </Border>
                <TextBlock Text="Fill" HorizontalAlignment="Center"/>
            </StackPanel>
            <StackPanel Margin="0,0,15,0">
                <Border BorderBrush="Gray" BorderThickness="1" Width="120" Height="80" ClipToBounds="True">
                    <Image Source="Images/smiley.png" Stretch="UniformToFill"/>
                </Border>
                <TextBlock Text="UniformToFill" HorizontalAlignment="Center"/>
            </StackPanel>
            <StackPanel>
                <Border BorderBrush="Gray" BorderThickness="1" Width="120" Height="80" ClipToBounds="True">
                    <Image Source="Images/smiley.png" Stretch="None"/>
                </Border>
                <TextBlock Text="None" HorizontalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <TextBlock Text="Obrázok zmenený v kóde (tlačidlami):" FontSize="16" Margin="0,25,0,10"/>
        <Image x:Name="imgMood" Source="Images/smiley.png" Width="100" Height="100" HorizontalAlignment="Left"/>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Smajlík" Width="90" Height="34" Click="BtnSmiley_Click"/>
            <Button Content="Smutný" Width="90" Height="34" Margin="10,0,0,0" Click="BtnSad_Click"/>
            <Button Content="Slnko" Width="90" Height="34" Margin="10,0,0,0" Click="BtnSun_Click"/>
            <Button Content="Mesiac" Width="90" Height="34" Margin="10,0,0,0" Click="BtnMoon_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
